{
  "name": "@nimjs/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build",
    "clean": "rm -rf .next coverage",
    "dev": "next dev",
    "lint": "eslint app components content lib mdx-components.tsx --ext .ts,.tsx",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "next typegen && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nimjs/registry": "workspace:*",
    "@nimjs/tokens": "workspace:*",
    "@nimjs/ui": "workspace:*",
    "@nimjs/utils": "workspace:*",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
