{
  "extends": "../../packages/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@nimjs/tokens": ["../../packages/tokens/src/index.ts"],
      "@nimjs/registry": ["../../packages/registry/src/index.ts"],
      "@nimjs/ui": ["../../packages/ui/src/index.ts"],
      "@nimjs/utils": ["../../packages/utils/src/index.ts"]
    },
    "jsx": "preserve"
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
